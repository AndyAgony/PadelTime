{
  "name": "padeltime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "vite build",
    "check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply padeltime-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply padeltime-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "better-auth": "^1.3.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.32.0"
  }
}

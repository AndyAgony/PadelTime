{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "padeltime",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "padeltime.andrewabony.com", "custom_domain": true }],
  "workers_dev": true,
  "vars": {
    // Swap for "PadelTime <login@andrewabony.com>" once the domain is verified in Resend.
    "MAIL_FROM": "PadelTime <onboarding@resend.dev>"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "padeltime-db",
      "database_id": "f40da4f8-9f69-4756-b6dd-7ac6699132ae",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
